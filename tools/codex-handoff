#!/usr/bin/env python3
"""Small, local-only validator for the Codex handoff ledger."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REQUIRED = [
    "README.md", "STATUS.md", "CURRENT_TASK.md",
    "templates/HANDOFF_TEMPLATE.md", "templates/REVIEW_TEMPLATE.md",
    "templates/CHANGE_TEMPLATE.md", "templates/INCIDENT_TEMPLATE.md",
]
FORBIDDEN_NAMES = {"MEMORY.md", ".env", "auth.json", "credentials.json"}
SECRET_PATTERNS = {
    "private key": re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    "GitHub token": re.compile(r"\b(?:ghp|github_pat)_[A-Za-z0-9_]{20,}\b"),
    "generic secret assignment": re.compile(
        r"(?i)\b(?:api[_-]?key|access[_-]?token|client[_-]?secret|password)\s*[:=]\s*['\"]?(?!<REDACTED>)[A-Za-z0-9_./+\-=]{12,}"
    ),
    "authorization header": re.compile(r"(?i)\bauthorization\s*:\s*(?:bearer|basic)\s+[A-Za-z0-9_./+\-=]{12,}"),
    "private host identifier": re.compile(r"\bsrv\d{5,}\b"),
}


def git(*args: str) -> str:
    return subprocess.check_output(["git", "-C", str(ROOT), *args], text=True)


def candidate_files() -> list[Path]:
    output = git("ls-files", "--cached", "--others", "--exclude-standard", "-z")
    return [ROOT / name for name in output.split("\0") if name]


def secret_scan() -> list[str]:
    findings: list[str] = []
    for path in candidate_files():
        rel = path.relative_to(ROOT)
        if path.name in FORBIDDEN_NAMES:
            findings.append(f"forbidden filename: {rel}")
            continue
        if not path.is_file() or path.stat().st_size > 1_000_000:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            findings.append(f"binary/unreadable file requires manual review: {rel}")
            continue
        for label, pattern in SECRET_PATTERNS.items():
            if pattern.search(text):
                findings.append(f"{label}: {rel}")
    return findings


def verify() -> int:
    errors = [f"missing: {name}" for name in REQUIRED if not (ROOT / name).is_file()]
    status = (ROOT / "STATUS.md").read_text(encoding="utf-8") if (ROOT / "STATUS.md").is_file() else ""
    handoffs = sorted((ROOT / "handoffs").glob("*.md")) if (ROOT / "handoffs").is_dir() else []
    if not handoffs:
        errors.append("no handoff document")
    for field in ("Overall status:", "Runtime:", "ChatGPT Review:", "Current Commit:"):
        if field not in status:
            errors.append(f"STATUS.md missing field: {field}")
    active = {}
    for field in ("Current Commit", "Reviewed Commit"):
        match = re.search(rf"^{field}:\s*(.+)$", status, re.MULTILINE)
        if match:
            active[field] = match.group(1).strip()
    if len(active) == 2 and active["Current Commit"] != active["Reviewed Commit"]:
        errors.append("STATUS.md active commit targets differ")
    errors.extend(secret_scan())
    if errors:
        for error in errors:
            print(f"FAIL {error}")
        return 1
    print(f"PASS structure={len(REQUIRED)} required-files handoffs={len(handoffs)} secret-findings=0")
    return 0


def snapshot() -> int:
    print(f"branch={git('branch', '--show-current').strip()}")
    print(f"commit={git('rev-parse', '--short=12', 'HEAD').strip()}")
    porcelain = git("status", "--porcelain")
    print(f"working_tree={'dirty' if porcelain else 'clean'}")
    print("changed_files:")
    for line in porcelain.splitlines():
        print(f"  {line[:2]} {line[3:]}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate or summarize the handoff ledger")
    parser.add_argument("command", choices=("verify", "secret-scan", "snapshot"))
    args = parser.parse_args()
    if args.command == "verify":
        return verify()
    if args.command == "secret-scan":
        findings = secret_scan()
        if findings:
            for finding in findings:
                print(f"FAIL {finding}")
            return 1
        print("PASS secret-findings=0")
        return 0
    return snapshot()


if __name__ == "__main__":
    sys.exit(main())
